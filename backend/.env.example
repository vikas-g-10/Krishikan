OPENAI_API_KEY=your_openai_api_key_here
PORT=3000

# Set to "groq" to run the Perception, Decision Synthesizer, and Adversarial Reviewer
# agents against Groq instead of OpenAI. Leave unset (or "openai") to use OpenAI directly,
# or set to "openrouter" to use OpenRouter.
MODEL_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides. If omitted, sensible per-agent defaults are used:
#   Perception (needs vision): meta-llama/llama-4-scout-17b-16e-instruct
#   Decision Synthesizer / Adversarial Reviewer (text-only, strict JSON schema): openai/gpt-oss-20b
# GROQ_MODEL=
# GROQ_PERCEPTION_MODEL=
# GROQ_SYNTHESIZER_MODEL=
# GROQ_REVIEWER_MODEL=
